{
  "name": "advantage-automacao",
  "version": "1.0.0",
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@badeball/cypress-cucumber-preprocessor": "19.2.0",
    "@cypress/browserify-preprocessor": "3.0.2",
    "@cypress/webpack-preprocessor": "^6.0.0",
    "@mmisty/cypress-allure-adapter": "0.16.2",
    "allure": "0.0.0",
    "allure-commandline": "2.27.0",
    "babel-loader": "^10.0.0",
    "cypress": "^13.6.1",
    "faker": "5.5.3",
    "webpack": "^5.98.0"
  },
  "cypress-cucumber-preprocessor": {
    "filterSpecs": true,
    "omitFiltered": true,
    "nonGlobalStepDefinitions": true,
    "stepDefinitions": "cypress/integration/**/*.js"
  },
  "scripts": {
    "cy:open": "cypress open",
    "headless:crhome": "cypress run --headless --browser crhome --config video=false --env allure=true",
    "headless:edge": "cypress run --headless --browser edge --config video=false --env allure=true",
    "allure:report:win": "node node_modules\\allure-commandline\\bin\\allure generate allure-results --clean -o  allure-report && npm run allure:open:win",
    "allure:report:mac": "node node_modules/allure-commandline/bin/allure generate allure-results --clean -o  allure-report && npm run allure:open:mac",
    "allure:open:win": "node node_modules\\allure-commandline\\bin\\allure open",
    "allure:open:mac": "nnode node_modules/allure-commandline/bin/allure open"
  },
  "keywords": [
    "cypress",
    "tests",
    "e2e",
    "cucumber"
  ],
  "author": "Bruna",
  "license": "ISC"
}
